generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==================== EMPRESAS (TENANTS) ====================

model Company {
  id          String   @id @default(cuid())
  name        String
  ruc         String   @unique
  legalName   String?  @map("legal_name")
  phone       String?
  email       String?
  address     String?
  city        String?
  department  String?
  country     String   @default("PY")
  logoUrl     String?  @map("logo_url")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  subscription    Subscription?
  settings        CompanySettings?
  modules         CompanyModule[]
  users           User[]
  metadataTypes   MetadataType[]
  metadataItems   MetadataItem[]

  @@index([isActive])
  @@map("companies")
}

model Subscription {
  id              String             @id @default(cuid())
  companyId       String             @unique @map("company_id")
  planType        PlanType           @default(BASIC) @map("plan_type")
  status          SubscriptionStatus @default(DEMO)
  trialEndsAt     DateTime?          @map("trial_ends_at")
  activatedAt     DateTime?          @map("activated_at")
  suspendedAt     DateTime?          @map("suspended_at")
  cancelledAt     DateTime?          @map("cancelled_at")
  maxUsers        Int                @default(5) @map("max_users")
  maxFieldWorkers Int                @default(10) @map("max_field_workers")
  monthlyPriceGs  Int                @default(0) @map("monthly_price_gs")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

enum PlanType {
  BASIC
  STANDARD
  PREMIUM
  ENTERPRISE
  CUSTOM
}

enum SubscriptionStatus {
  DEMO
  ACTIVE
  SUSPENDED
  CANCELLED
}

model CompanyModule {
  id         String        @id @default(cuid())
  companyId  String        @map("company_id")
  module     ServiceModule
  isEnabled  Boolean       @default(true) @map("is_enabled")
  configJson Json?         @map("config_json")
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, module])
  @@map("company_modules")
}

enum ServiceModule {
  VISITS
  ORDERS
  GPS_TRACKING
  INVENTORY
  ATTENDANCE
  GUARD_SECURITY
  MEDICAL_VISITS
  COURIER
  METADATA_CRUD
}

model CompanySettings {
  id                    String  @id @default(cuid())
  companyId             String  @unique @map("company_id")
  timezone              String  @default("America/Asuncion")
  locale                String  @default("es-PY")
  currency              String  @default("PYG")
  gpsTrackingIntervalMs Int     @default(300000) @map("gps_tracking_interval_ms")
  allowOfflineMode      Boolean @default(true) @map("allow_offline_mode")
  requireGpsForMarks    Boolean @default(true) @map("require_gps_for_marks")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("company_settings")
}

// ==================== USUARIOS ====================

model User {
  id             String    @id @default(cuid())
  companyId      String?   @map("company_id")
  email          String    @unique
  passwordHash   String    @map("password_hash")
  firstName      String    @map("first_name")
  lastName       String    @map("last_name")
  phone          String?
  role           UserRole
  isActive       Boolean   @default(true) @map("is_active")
  lastLoginAt    DateTime? @map("last_login_at")
  expoPushToken  String?   @map("expo_push_token")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  company        Company?       @relation(fields: [companyId], references: [id])
  refreshTokens  RefreshToken[]

  @@index([companyId])
  @@index([role])
  @@map("users")
}

enum UserRole {
  SUPER_ADMIN
  COMPANY_ADMIN
  FIELD_WORKER
}

model RefreshToken {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  token      String    @unique
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  deviceInfo String?   @map("device_info")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@map("refresh_tokens")
}

// ==================== DATOS MAESTROS (METADATA) ====================

model MetadataType {
  id        String   @id @default(cuid())
  companyId String   @map("company_id")
  code      String
  name      String
  canCreate Boolean  @default(true) @map("can_create")
  canRead   Boolean  @default(true) @map("can_read")
  canUpdate Boolean  @default(true) @map("can_update")
  canDelete Boolean  @default(true) @map("can_delete")
  isSystem  Boolean  @default(false) @map("is_system")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items   MetadataItem[]

  @@unique([companyId, code])
  @@index([companyId])
  @@map("metadata_types")
}

model MetadataItem {
  id             String    @id @default(cuid())
  companyId      String    @map("company_id")
  metadataTypeId String    @map("metadata_type_id")
  code           String
  value          String
  extraData      Json?     @map("extra_data")
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  company      Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  metadataType MetadataType @relation(fields: [metadataTypeId], references: [id], onDelete: Cascade)

  @@unique([companyId, metadataTypeId, code])
  @@index([companyId, metadataTypeId])
  @@map("metadata_items")
}

// ==================== VISITAS ====================

model Visit {
  id          String         @id @default(cuid())
  companyId   String         @map("company_id")
  userId      String         @map("user_id")
  clientCode  String         @map("client_code")
  motiveCode  String?        @map("motive_code")
  eventType   VisitEventType @map("event_type")
  observation String?
  latitude    Float?
  longitude   Float?
  markedAt    DateTime       @default(now()) @map("marked_at")
  createdAt   DateTime       @default(now()) @map("created_at")

  @@index([companyId])
  @@index([companyId, userId, markedAt])
  @@map("visits")
}

enum VisitEventType {
  START
  END
  QUICK
}

// ==================== PEDIDOS ====================

model Order {
  id            String      @id @default(cuid())
  companyId     String      @map("company_id")
  userId        String      @map("user_id")
  clientCode    String      @map("client_code")
  priceList     String?     @map("price_list")
  saleCondition String?     @map("sale_condition")
  observation   String?
  status        OrderStatus @default(PENDING)
  totalAmountGs Int         @default(0) @map("total_amount_gs")
  latitude      Float?
  longitude     Float?
  markedAt      DateTime    @default(now()) @map("marked_at")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  items OrderItem[]

  @@index([companyId])
  @@index([companyId, userId, markedAt])
  @@index([companyId, status])
  @@map("orders")
}

model OrderItem {
  id          String @id @default(cuid())
  orderId     String @map("order_id")
  lineNumber  Int    @map("line_number")
  productCode String @map("product_code")
  quantity    Decimal @db.Decimal(12, 4)
  unitPriceGs Decimal? @db.Decimal(12, 0) @map("unit_price_gs")
  discountPct Decimal? @db.Decimal(5, 2) @map("discount_pct")
  subtotalGs  Decimal? @db.Decimal(12, 0) @map("subtotal_gs")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_items")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

// ==================== RASTREO GPS ====================

model GpsLocation {
  id           String   @id @default(cuid())
  companyId    String   @map("company_id")
  userId       String   @map("user_id")
  latitude     Float
  longitude    Float
  accuracy     Float?
  altitude     Float?
  speed        Float?
  heading      Float?
  batteryLevel Int?     @map("battery_level")
  recordedAt   DateTime @map("recorded_at")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([companyId, userId, recordedAt])
  @@index([companyId, recordedAt])
  @@map("gps_locations")
}

// ==================== INVENTARIO ====================

model InventoryRecord {
  id          String   @id @default(cuid())
  companyId   String   @map("company_id")
  userId      String   @map("user_id")
  depositCode String   @map("deposit_code")
  productCode String   @map("product_code")
  quantity    Decimal  @db.Decimal(12, 4)
  observation String?
  latitude    Float?
  longitude   Float?
  markedAt    DateTime @default(now()) @map("marked_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([companyId])
  @@index([companyId, depositCode])
  @@map("inventory_records")
}

// ==================== ASISTENCIA ====================

model AttendanceEvent {
  id            String             @id @default(cuid())
  companyId     String             @map("company_id")
  userId        String             @map("user_id")
  employeeCode  String             @map("employee_code")
  eventCategory AttendanceCategory @map("event_category")
  eventAction   AttendanceAction   @map("event_action")
  observation   String?
  latitude      Float?
  longitude     Float?
  markedAt      DateTime           @default(now()) @map("marked_at")
  createdAt     DateTime           @default(now()) @map("created_at")

  @@index([companyId])
  @@index([companyId, employeeCode, markedAt])
  @@map("attendance_events")
}

enum AttendanceCategory {
  PRESENCE
  BREAK
  LUNCH
}

enum AttendanceAction {
  IN
  OUT
}

// ==================== GUARDIA ====================

model GuardShift {
  id          String              @id @default(cuid())
  companyId   String              @map("company_id")
  userId      String              @map("user_id")
  guardCode   String              @map("guard_code")
  eventType   GuardShiftEventType @default(MARK) @map("event_type")
  place       String?
  observation String?
  latitude    Float?
  longitude   Float?
  markedAt    DateTime            @default(now()) @map("marked_at")
  createdAt   DateTime            @default(now()) @map("created_at")

  @@index([companyId])
  @@index([companyId, guardCode, markedAt])
  @@map("guard_shifts")
}

enum GuardShiftEventType {
  SHIFT_START
  SHIFT_END
  MARK
}

// ==================== VISITA MÉDICA ====================

model MedicalVisit {
  id               String                @id @default(cuid())
  companyId        String                @map("company_id")
  userId           String                @map("user_id")
  eventType        MedicalVisitEventType @map("event_type")
  clinicCode       String?               @map("clinic_code")
  medicCode        String?               @map("medic_code")
  motiveCode       String?               @map("motive_code")
  initialKm        Decimal?              @db.Decimal(10, 2) @map("initial_km")
  nextVisitDate    DateTime?             @map("next_visit_date")
  shouldNotify     Boolean               @default(false) @map("should_notify")
  notificationDesc String?               @map("notification_desc")
  observation      String?
  latitude         Float?
  longitude        Float?
  markedAt         DateTime              @default(now()) @map("marked_at")
  createdAt        DateTime              @default(now()) @map("created_at")

  products MedicalVisitProduct[]

  @@index([companyId])
  @@index([companyId, clinicCode])
  @@map("medical_visits")
}

model MedicalVisitProduct {
  id             String  @id @default(cuid())
  medicalVisitId String  @map("medical_visit_id")
  lineNumber     Int     @map("line_number")
  productCode    String  @map("product_code")
  quantity       Decimal @db.Decimal(12, 4)

  medicalVisit MedicalVisit @relation(fields: [medicalVisitId], references: [id], onDelete: Cascade)

  @@index([medicalVisitId])
  @@map("medical_visit_products")
}

enum MedicalVisitEventType {
  CLINIC_START
  CLINIC_END
  MEDIC_START
  MEDIC_END
  CLINIC_QUICK
  PRODUCT_REGISTER
}

// ==================== COURIER ====================

model CourierDelivery {
  id           String               @id @default(cuid())
  companyId    String               @map("company_id")
  userId       String               @map("user_id")
  status       CourierDeliveryStatus
  receiverName String?              @map("receiver_name")
  motiveCode   String?              @map("motive_code")
  observation  String?
  latitude     Float?
  longitude    Float?
  markedAt     DateTime             @default(now()) @map("marked_at")
  createdAt    DateTime             @default(now()) @map("created_at")

  items CourierItem[]

  @@index([companyId])
  @@index([companyId, status])
  @@map("courier_deliveries")
}

model CourierItem {
  id                String @id @default(cuid())
  courierDeliveryId String @map("courier_delivery_id")
  lineNumber        Int    @map("line_number")
  barcode           String

  courierDelivery CourierDelivery @relation(fields: [courierDeliveryId], references: [id], onDelete: Cascade)

  @@index([courierDeliveryId])
  @@map("courier_items")
}

enum CourierDeliveryStatus {
  DELIVERED
  NOT_DELIVERED
}

// ==================== COLA DE SINCRONIZACIÓN ====================

model SyncQueueItem {
  id             String     @id @default(cuid())
  companyId      String     @map("company_id")
  userId         String     @map("user_id")
  entityType     String     @map("entity_type")
  idempotencyKey String     @unique @map("idempotency_key")
  payload        Json
  status         SyncStatus @default(PENDING)
  resultId       String?    @map("result_id")
  errorMessage   String?    @map("error_message")
  createdAt      DateTime   @default(now()) @map("created_at")
  processedAt    DateTime?  @map("processed_at")

  @@index([companyId, userId, status])
  @@index([idempotencyKey])
  @@map("sync_queue")
}

enum SyncStatus {
  PENDING
  SYNCED
  FAILED
}
